# ═══════════════════════════════════════════════════════
# LearnLab AI — .gitignore
# ═══════════════════════════════════════════════════════

# ─── Secrets et configuration sensible ─────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/

# ─── Claude Code (assistant local) ─────────────────────
CLAUDE.md
.claude/

# ─── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover
.hypothesis/

# ─── Environnements virtuels Python ────────────────────
venv/
.venv/
env/
.env/
ENV/

# ─── Node / Frontend ───────────────────────────────────
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo

# ─── Bun ───────────────────────────────────────────────
.bun/
bun.lockb

# ─── Logs ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Docker ────────────────────────────────────────────
# On garde docker-compose.yml mais pas les overrides locaux
docker-compose.override.yml
docker-compose.local.yml

# ─── Base de données locale ─────────────────────────────
*.sqlite
*.sqlite3
*.db
pgdata/
postgres_data/

# ─── Qdrant data local ─────────────────────────────────
qdrant_storage/
qdrant_data/

# ─── MinIO data local ──────────────────────────────────
minio_data/
.minio/

# ─── Redis data local ──────────────────────────────────
redis_data/
dump.rdb

# ─── Uploads et fichiers temporaires ───────────────────
uploads/
tmp/
temp/
*.tmp

# ─── IDEs et éditeurs ──────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Alembic ───────────────────────────────────────────
# On garde les migrations mais pas les fichiers de test
alembic/versions/__pycache__/

# ─── Tests ─────────────────────────────────────────────
.pytest_cache/
test_results/
coverage_html/

# ─── Jupyter (si utilisé pour exploration) ─────────────
.ipynb_checkpoints/
*.ipynb

# ─── Fichiers générés ──────────────────────────────────
*.pyc
*.pyo
